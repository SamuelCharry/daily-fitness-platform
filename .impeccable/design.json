  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicit save and finish actions.",
      "html": "<button class=\"ds-primary\">Guardar cambios</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:12px 17px;font:600 13px/1.2 Inter,system-ui,sans-serif;white-space:nowrap;cursor:pointer;background:var(--accent);color:var(--accent-text);border:1px solid transparent}.ds-primary:hover{background:var(--accent-hover)}.ds-primary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }.ds-primary:disabled{opacity:.55;cursor:default}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color 140ms ease-out}}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary navigation and export actions.",
      "html": "<button class=\"ds-ghost\">Exportar CSV</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;border-radius:8px;padding:12px 17px;font:600 13px/1.2 Inter,system-ui,sans-serif;white-space:nowrap;cursor:pointer;background:transparent;color:var(--text);border:1px solid var(--border2)}.ds-ghost:hover{background:var(--hover-bg);color:var(--text-strong)}.ds-ghost:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }.ds-ghost:disabled{opacity:.55;cursor:default}@media(prefers-reduced-motion:no-preference){.ds-ghost{transition:background-color 140ms ease-out}}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input",
      "description": "Measurements with visible labels and keyboard focus.",
      "html": "<label class=\"ds-field\"><span>Peso · kg</span><input class=\"ds-input\" aria-label=\"Peso en kilogramos\" inputmode=\"decimal\" placeholder=\"—\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:400 12px Inter,system-ui,sans-serif;color:var(--text-muted)}.ds-input{background:var(--input-bg);border:1px solid var(--border2);border-radius:7px;padding:11px 12px;font:400 14px Inter,system-ui,sans-serif;color:var(--text);caret-color:var(--accent);min-width:0;max-width:100%}.ds-input::placeholder{color:var(--text-dim)}.ds-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Warm selected context with a stroke SVG icon.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación principal\"><a class=\"ds-nav-item ds-selected\" href=\"#resumen\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z\"/></svg>Mi resumen</a><a class=\"ds-nav-item\" href=\"#bitacora\">Bitácora diaria</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px}.ds-nav-item{padding:12px;display:flex;align-items:center;gap:12px;color:var(--text-muted);font:500 13px Inter,system-ui,sans-serif;border-radius:8px;text-decoration:none}.ds-nav-item:hover{background:var(--hover-bg);color:var(--text)}.ds-nav-item.ds-selected{background:var(--accent-soft);color:var(--accent)}.ds-nav-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }@media(prefers-reduced-motion:no-preference){.ds-nav-item{transition:background-color 140ms ease-out}}@media(max-width:760px){.ds-nav{flex-direction:row;overflow-x:auto;gap:2px}.ds-nav-item{font-size:11px;padding:9px;gap:6px;white-space:nowrap}.ds-nav-item svg{width:16px;height:16px}}"
    },
    {
      "name": "Filter chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Outlined filter with a filled active state.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-active\" aria-pressed=\"true\">Todos</button><button class=\"ds-chip\" aria-pressed=\"false\">Piernas</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{padding:6px 12px;border-radius:6px;font:400 12px Inter,system-ui,sans-serif;background:transparent;border:1px solid var(--border2);color:var(--text-muted);cursor:pointer}.ds-chip.ds-active{background:var(--accent);color:var(--accent-text);border-color:var(--accent)}.ds-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }"
    },
    {
      "name": "Paper panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat working container with a fine border.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Tu progreso</h2><p class=\"ds-panel-help\">Tus registros, en perspectiva.</p></section>",
      "css": ".ds-panel{background:var(--bg-alt);border:1px solid var(--border);border-radius:12px;padding:24px;min-width:0}.ds-panel-title{font:600 20px Inter Tight,sans-serif;letter-spacing:-.015em;color:var(--text);margin:0}.ds-panel-help{font:400 11px/1.65 Inter,system-ui,sans-serif;color:var(--text-muted);margin:16px 0 0}@media(max-width:760px){.ds-panel{padding:18px}.ds-panel-title{font-size:18px}}"
    },
    {
      "name": "Journal cells",
      "kind": "custom",
      "refersTo": "sheet-cell",
      "description": "Grid editing with sticky dates and inset focus.",
      "html": "<div class=\"ds-sheet-scroll\" role=\"region\" aria-label=\"Registro diario editable\" tabindex=\"0\"><table class=\"ds-sheet\"><thead><tr><th scope=\"col\">Fecha</th><th scope=\"col\">Peso · kg</th><th scope=\"col\">Estado</th></tr></thead><tbody><tr><th scope=\"row\">Hoy</th><td><input class=\"ds-cell\" aria-label=\"Peso, hoy\" inputmode=\"decimal\" placeholder=\"—\"></td><td class=\"ds-row-status\">Sin registro</td></tr></tbody></table></div>",
      "css": ".ds-sheet-scroll{overflow:auto;border:1px solid var(--border);border-radius:10px;background:var(--bg-alt);max-height:65vh}.ds-sheet-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }.ds-sheet{border-collapse:collapse;font:400 12px Inter,system-ui,sans-serif;font-variant-numeric:tabular-nums;width:100%;text-align:left;color:var(--text)}.ds-sheet th,.ds-sheet td{border-bottom:1px solid var(--border);border-right:1px solid var(--border);padding:0}.ds-sheet thead th{position:sticky;top:0;z-index:2;background:var(--bg-raised);color:var(--text-muted);padding:13px 12px;white-space:nowrap;font-size:11px;font-weight:500}.ds-sheet tbody th{position:sticky;left:0;background:var(--bg-alt);padding:10px 12px;min-width:105px;font-weight:500;z-index:1}.ds-sheet tbody tr:hover{background:var(--bg)}.ds-cell{width:102px;min-width:85px;max-width:none;padding:14px 12px;border:0;border-radius:0;background:transparent;font:400 12px Inter,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--text);caret-color:var(--accent)}.ds-cell::placeholder{color:var(--text-dim)}.ds-cell:focus,.ds-cell:focus-visible{background:var(--accent-soft);outline:2px solid var(--accent);outline-offset:-2px}.ds-sheet .ds-row-status{font-size:10px;padding:0 14px;color:var(--text-muted);white-space:nowrap}"
    },
    {
      "name": "Exercise selector",
      "kind": "nav",
      "refersTo": "exercise-tab",
      "description": "Horizontal exercise navigation with explicit selection.",
      "html": "<nav class=\"ds-exercise-tabs\" aria-label=\"Ejercicios de la sesión\"><button class=\"ds-exercise-tab ds-active\" aria-pressed=\"true\"><span>1</span>Press de banca</button><button class=\"ds-exercise-tab\" aria-pressed=\"false\"><span>2</span>Remo</button></nav>",
      "css": ".ds-exercise-tabs{display:flex;gap:8px;overflow:auto;padding-bottom:8px}.ds-exercise-tab{display:flex;align-items:center;gap:8px;font:400 11px Inter,system-ui,sans-serif;background:var(--bg-alt);color:var(--text-muted);border:1px solid var(--border);border-radius:8px;padding:10px 12px;white-space:nowrap;cursor:pointer}.ds-exercise-tab.ds-active{border-color:var(--accent);background:var(--accent-soft);color:var(--accent)}.ds-exercise-tab span{font-variant-numeric:tabular-nums}.ds-exercise-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }"
    },
    {
      "name": "Rest bar",
      "kind": "custom",
      "refersTo": "rest-bar",
      "description": "Sticky session timer and explicit skip action.",
      "html": "<div class=\"ds-rest\" role=\"status\"><span>Descanso</span><strong>1:30</strong><button class=\"ds-rest-action\">Saltar descanso</button></div>",
      "css": ".ds-rest{position:sticky;top:8px;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-radius:8px;background:var(--accent);color:var(--accent-text);font:400 12px Inter,system-ui,sans-serif;gap:12px}.ds-rest strong{font-size:24px;font-variant-numeric:tabular-nums}.ds-rest-action{background:none;border:0;color:inherit;text-decoration:underline;font:400 12px Inter,system-ui,sans-serif;cursor:pointer}.ds-rest-action:focus-visible{outline:2px solid var(--accent);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "The Personal Training Journal",
    "overview": "Warm paper, compact controls and clear numbers give the athlete a practical place to work each day. The user-confirmed direction is spreadsheet comfort, red without black, and a session flow inspired by MacroFactor Workouts. The built interface expresses this through direct cell editing, quiet navigation and explicit set confirmation.\n\nThe default theme is light. An optional warm brown dark theme preserves the same semantic roles and geometry; system mode follows the operating system. Personal utility governs the visual density: table rows and exercise targets stay compact while headings and section gaps make the working hierarchy clear.",
    "keyCharacteristics": [
      "Warm surfaces and brick-red actions.",
      "Flat containers and visible table dividers.",
      "Inter Tight headings, Inter controls and tabular numbers.",
      "Explicit selection, focus and save states."
    ],
    "rules": [
      {
        "name": "The Warm Surface Rule",
        "body": "Use the existing warm semantic surfaces and red action roles; preserve the confirmed red-without-black identity.",
        "section": "colors"
      },
      {
        "name": "The Stable Numbers Rule",
        "body": "Use tabular numerals for measurements, tables, summaries, set history and timer digits so changing values do not shift their columns.",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "Separate containers through semantic surfaces and thin borders, as the existing journal and panels do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic warm surfaces, accent roles and existing control geometry.",
      "Do keep tabular numerals and persistent column alignment in measurement views.",
      "Do preserve labeled fields, visible keyboard focus, explicit confirmation and textual status.",
      "Do keep wide journals scrollable with sticky dates while compact navigation adapts to mobile.",
      "Do restrict short background transitions to the existing reduced-motion preference condition."
    ],
    "donts": [
      "Don't restore black surfaces or the previous red-and-black identity.",
      "Don't add decorative elevation to the flat paper containers.",
      "Don't replace labels and save states with color alone.",
      "Don't invent a new breakpoint or rounded scale when the existing component pattern applies."
    ]
  }
}
